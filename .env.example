# Copy to .env and fill in. .env is never committed.
# Local development (profile "dev", default). The API listens on 8510 (project 85, standard port).

# --- Database ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nimokids
DB_USER=nimokids
DB_PASSWORD=change-me

# --- Optional (dev has safe defaults; production REQUIRES JWT_SECRET) ---
# SERVER_PORT=8510
# JWT_SECRET=<base64 string, at least 256 bits>
# CORS_ALLOWED_ORIGINS=http://localhost:8500

# --- Docker (docker-compose.yml reads this same file as .env) ---
# On the server DB_HOST is the Postgres container/host reachable from shared-db-network (default: postgres-main).
# JWT_SECRET is REQUIRED by the prod profile:  openssl rand -base64 48
# JWT_SECRET=
# WEB_CONTEXT=../NimoKids_website
